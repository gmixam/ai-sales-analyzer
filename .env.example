COMPOSE_PROJECT_NAME=asa
# asa = ai-sales-analyzer, all containers will get the asa_ prefix

POSTGRES_DB=ai_sales_analyzer
POSTGRES_USER=asa_app
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://asa_app:CHANGE_ME@asa_postgres:5432/ai_sales_analyzer

REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@asa_redis:6379/0

OPENAI_API_KEY=sk-...
OPENAI_MODEL_CLASSIFY=gpt-4o-mini
OPENAI_MODEL_ANALYZE=gpt-4o
OPENAI_MODEL_STT=whisper-1
OPENAI_API_KEY_STT_MAIN=sk-...
OPENAI_API_KEY_LLM1_MAIN=sk-...
OPENAI_API_KEY_LLM2_MAIN=sk-...
OPENAI_API_KEY_LLM3_MAIN=sk-...
MOONSHOT_API_KEY=sk-...

ASSEMBLYAI_API_KEY=...
ASSEMBLYAI_LANGUAGE=ru

STT_PROVIDER=assemblyai
MANUAL_LIVE_STT_PROVIDER=
STT_LANGUAGE=ru

AI_STT_ROUTING_POLICY=fixed
AI_STT_PROVIDERS_JSON=
AI_STT_FIXED_ACCOUNT_ALIAS=
AI_STT_FORCE_ACCOUNT_ALIAS=

AI_LLM1_ROUTING_POLICY=fixed
AI_LLM1_PROVIDERS_JSON=[{"provider":"openai","account_alias":"llm1_main","model":"gpt-5.4-nano","api_base":"https://api.openai.com/v1","endpoint":"/chat/completions","api_key_env":"OPENAI_API_KEY_LLM1_MAIN","enabled":true,"priority":1,"weight":100,"timeout_sec":120,"max_retries_for_this_provider":1,"tags":["pilot","llm1","cost_optimized"],"notes":"cost optimized production LLM1"},{"provider":"openai","account_alias":"kimi_llm1_main","model":"moonshot-v1-8k","api_base":"https://api.moonshot.ai/v1","endpoint":"/chat/completions","api_key_env":"MOONSHOT_API_KEY","enabled":true,"priority":2,"weight":100,"timeout_sec":180,"max_retries_for_this_provider":1,"tags":["pilot","llm1","kimi","moonshot","moonshot_v1","openai_compatible"],"notes":"Kimi/Moonshot OpenAI-compatible trial source for low-cost LLM1"}]
AI_LLM1_FIXED_ACCOUNT_ALIAS=
AI_LLM1_FORCE_ACCOUNT_ALIAS=

AI_LLM2_ROUTING_POLICY=fixed
AI_LLM2_PROVIDERS_JSON=[{"provider":"openai","account_alias":"llm2_main","model":"gpt-5.4-mini","api_base":"https://api.openai.com/v1","endpoint":"/chat/completions","api_key_env":"OPENAI_API_KEY_LLM2_MAIN","enabled":true,"priority":1,"weight":100,"timeout_sec":300,"max_retries_for_this_provider":1,"tags":["pilot","llm2","cost_optimized"],"notes":"cost optimized production LLM2"},{"provider":"openai","account_alias":"kimi_llm2_main","model":"moonshot-v1-128k","api_base":"https://api.moonshot.ai/v1","endpoint":"/chat/completions","api_key_env":"MOONSHOT_API_KEY","enabled":true,"priority":2,"weight":100,"timeout_sec":300,"max_retries_for_this_provider":1,"tags":["pilot","llm2","kimi","moonshot","moonshot_v1","openai_compatible"],"notes":"Kimi/Moonshot OpenAI-compatible trial source for LLM2"}]
AI_LLM2_FIXED_ACCOUNT_ALIAS=
AI_LLM2_FORCE_ACCOUNT_ALIAS=
AI_LLM2_ANALYSIS_MODE=layered
AI_LLM2_INPUT_PROFILE=full
AI_LLM2_OUTPUT_MAX_TOKENS=8192
AI_LLM2_LOCAL_JSON_REPAIR_ENABLED=false
AI_LLM2_REPORT_EVIDENCE_VALIDATION_ENABLED=false
AI_LLM2_SEMANTIC_VALIDATION_ENABLED=false

LLM3_ENABLED=false
AI_LLM3_ROUTING_POLICY=fixed
AI_LLM3_PROVIDERS_JSON=[{"provider":"openai","account_alias":"llm3_main","model":"gpt-5.4-mini","api_base":"https://api.openai.com/v1","endpoint":"/chat/completions","api_key_env":"OPENAI_API_KEY_LLM3_MAIN","enabled":true,"priority":1,"weight":100,"timeout_sec":300,"max_retries_for_this_provider":1,"tags":["pilot","llm3","situation_day_composer","cost_optimized"],"notes":"cost optimized production LLM3"},{"provider":"openai","account_alias":"kimi_llm3_main","model":"moonshot-v1-128k","api_base":"https://api.moonshot.ai/v1","endpoint":"/chat/completions","api_key_env":"MOONSHOT_API_KEY","enabled":true,"priority":2,"weight":100,"timeout_sec":300,"max_retries_for_this_provider":1,"tags":["pilot","llm3","kimi","moonshot","moonshot_v1","openai_compatible"],"notes":"Kimi/Moonshot OpenAI-compatible trial source for LLM3"}]
AI_LLM3_FIXED_ACCOUNT_ALIAS=llm3_main
AI_LLM3_FORCE_ACCOUNT_ALIAS=

AI_LLM_SIMULATION_ENABLED=false
AI_LLM_SIMULATION_RUN_ID=
AI_LLM_SIMULATION_SEED=
AI_LLM_SIMULATION_ARTIFACT_DIR=/tmp/asa_llm_sim_runs
AI_LLM_EXECUTION_MODE=openai_compatible
AI_LLM_SUBAGENT_RUNTIME_ENABLED=false
AI_LLM_SUBAGENT_RUNTIME_LAYERS=
AI_LLM_SUBAGENT_RUNNER_CMD=
AI_LLM_SUBAGENT_COMMAND=
AI_LLM_SUBAGENT_RUN_ID=
AI_LLM_SUBAGENT_ARTIFACT_DIR=/tmp/asa_llm_subagent_runs
AI_LLM_SUBAGENT_TIMEOUT_SEC=300

ONLINEPBX_DOMAIN=yourcompany
ONLINEPBX_API_KEY=...
ONLINEPBX_API_BASE_URL=
ONLINEPBX_CDR_URL=

BITRIX24_WEBHOOK_URL=https://yourcompany.bitrix24.ru/rest/1/xxx/
BITRIX24_READONLY_ENABLED=true
BITRIX24_TARGET_DEPARTMENT_IDS=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=...
SMTP_PASSWORD=...
SMTP_FROM=noreply@...

TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID_ROP=...
TEST_DELIVERY_TELEGRAM_CHAT_ID=
TEST_DELIVERY_EMAIL_TO=

NGINX_HTTP_PORT=8081
NGINX_HTTPS_PORT=8444
FLOWER_PORT=5556
FLOWER_USER=admin
FLOWER_PASSWORD=CHANGE_ME

APP_ENV=production
LOG_LEVEL=INFO

MANUAL_PILOT_ENABLED=false
MANUAL_PILOT_EXTENSIONS=
MANUAL_PILOT_PHONES=
MANUAL_PILOT_EXTERNAL_IDS=
MANUAL_PILOT_MAX_CALLS=1

CALLS_MIN_DURATION_SEC=180
CALLS_MAX_DAILY_PER_MANAGER=20
CALLS_WEEKLY_PACK_SIZE=15
