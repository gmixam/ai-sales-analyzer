# Upstream call-processing secrets and routing.
# Copy to .env.call-processing and replace CHANGE_ME values outside git.
# Do not add LLM2, LLM3, SMTP, Telegram, or business delivery secrets here.

ONLINEPBX_DOMAIN=CHANGE_ME_ONLINEPBX_DOMAIN
ONLINEPBX_API_KEY=CHANGE_ME_ONLINEPBX_API_KEY
ONLINEPBX_API_BASE_URL=
ONLINEPBX_CDR_URL=

STT_PROVIDER=assemblyai
MANUAL_LIVE_STT_PROVIDER=
STT_LANGUAGE=ru
ASSEMBLYAI_LANGUAGE=ru
ASSEMBLYAI_API_KEY=CHANGE_ME_ASSEMBLYAI_API_KEY
OPENAI_API_KEY_STT_MAIN=CHANGE_ME_OPENAI_STT_KEY_IF_USED

AI_STT_ROUTING_POLICY=fixed
AI_STT_PROVIDERS_JSON=[{"provider":"assemblyai","account_alias":"stt_main","model":"assemblyai_default","api_key_env":"ASSEMBLYAI_API_KEY","enabled":true,"priority":1,"weight":100,"timeout_sec":300,"max_retries_for_this_provider":0,"tags":["split","stt","call_processing"]}]
AI_STT_FIXED_ACCOUNT_ALIAS=stt_main
AI_STT_FORCE_ACCOUNT_ALIAS=

OPENAI_MODEL_CLASSIFY=gpt-4o-mini
OPENAI_API_KEY_LLM1_MAIN=CHANGE_ME_LLM1_API_KEY
AI_LLM1_ROUTING_POLICY=fixed
AI_LLM1_PROVIDERS_JSON=[{"provider":"openai","account_alias":"llm1_main","model":"gpt-4o-mini","api_base":"https://api.openai.com/v1","endpoint":"/chat/completions","api_key_env":"OPENAI_API_KEY_LLM1_MAIN","enabled":true,"priority":1,"weight":100,"timeout_sec":120,"max_retries_for_this_provider":1,"tags":["split","llm1","call_processing"]}]
AI_LLM1_FIXED_ACCOUNT_ALIAS=llm1_main
AI_LLM1_FORCE_ACCOUNT_ALIAS=
