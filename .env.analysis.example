# Downstream analysis/reporting secrets and routing.
# Copy to .env.analysis and replace CHANGE_ME values outside git.
# Do not add OnlinePBX, STT, or LLM1 secrets here.

CALL_PROCESSING_API_BASE_URL=http://asa_call_processing_api:8000
CALL_PROCESSING_ACCESS_GRANT_JSON={"client_id":"edo-analysis-reporting","client_type":"service","role":"admin","allowed_artifact_kinds":["transcript","transcript_segments","llm1_first_pass"],"read_surfaces":["processed_calls_v1","transcripts_v1","llm1_artifacts_v1","processing_runs_v1"],"rate_limits":{"provider_calls_per_run":200},"created_by_admin":"CHANGE_ME_OPERATOR","active":true}

OPENAI_MODEL_ANALYZE=gpt-4o
OPENAI_API_KEY_LLM2_MAIN=CHANGE_ME_LLM2_API_KEY
AI_LLM2_ROUTING_POLICY=fixed
AI_LLM2_PROVIDERS_JSON=[{"provider":"openai","account_alias":"llm2_main","model":"gpt-4o","api_base":"https://api.openai.com/v1","endpoint":"/chat/completions","api_key_env":"OPENAI_API_KEY_LLM2_MAIN","enabled":true,"priority":1,"weight":100,"timeout_sec":300,"max_retries_for_this_provider":1,"tags":["split","llm2","analysis"]}]
AI_LLM2_FIXED_ACCOUNT_ALIAS=llm2_main
AI_LLM2_FORCE_ACCOUNT_ALIAS=
AI_LLM2_ANALYSIS_MODE=layered
AI_LLM2_INPUT_PROFILE=compact
AI_LLM2_OUTPUT_MAX_TOKENS=8192
AI_LLM2_LOCAL_JSON_REPAIR_ENABLED=false
AI_LLM2_REPORT_EVIDENCE_VALIDATION_ENABLED=false
AI_LLM2_SEMANTIC_VALIDATION_ENABLED=false

LLM3_ENABLED=false
OPENAI_API_KEY_LLM3_MAIN=CHANGE_ME_LLM3_API_KEY_IF_ENABLED
AI_LLM3_ROUTING_POLICY=fixed
AI_LLM3_PROVIDERS_JSON=[{"provider":"openai","account_alias":"llm3_main","model":"gpt-4o-mini","api_base":"https://api.openai.com/v1","endpoint":"/chat/completions","api_key_env":"OPENAI_API_KEY_LLM3_MAIN","enabled":true,"priority":1,"weight":100,"timeout_sec":300,"max_retries_for_this_provider":1,"tags":["split","llm3","analysis"]}]
AI_LLM3_FIXED_ACCOUNT_ALIAS=llm3_main
AI_LLM3_FORCE_ACCOUNT_ALIAS=

BITRIX24_WEBHOOK_URL=CHANGE_ME_BITRIX24_WEBHOOK_URL
BITRIX24_READONLY_ENABLED=true
BITRIX24_TARGET_DEPARTMENT_IDS=[]

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME_SMTP_USER
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=CHANGE_ME_SMTP_FROM
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_TO=CHANGE_ME_ALERT_RECIPIENT
ALERT_EMAIL_MIN_LEVEL=warning
ALERT_EMAIL_ON_START=true
ALERT_EMAIL_ON_SUCCESS=false
MANAGER_DAILY_ROP_EMAIL_ENABLED=true
MANAGER_DAILY_ROP_EMAIL_TO=edo.rop@dogovor24.kz

TELEGRAM_BOT_TOKEN=CHANGE_ME_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID_ROP=CHANGE_ME_TELEGRAM_ROP_CHAT_ID
TEST_DELIVERY_TELEGRAM_CHAT_ID=
TEST_DELIVERY_EMAIL_TO=
