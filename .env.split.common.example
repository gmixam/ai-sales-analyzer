# Common split-runtime values shared by call-processing and analysis services.
# Copy to .env.split.common and replace CHANGE_ME values outside git.

COMPOSE_PROJECT_NAME=asa
APP_ENV=production
LOG_LEVEL=INFO

POSTGRES_DB=ai_sales_analyzer
POSTGRES_USER=asa_app
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_URL=postgresql://asa_app:CHANGE_ME_DB_PASSWORD@asa_postgres:5432/ai_sales_analyzer

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@asa_redis:6379/0

CALL_PROCESSING_CLIENT_TIMEOUT_SEC=180

AI_LLM_EXECUTION_MODE=openai_compatible
AI_LLM_SIMULATION_ENABLED=false
AI_LLM_SIMULATION_RUN_ID=
AI_LLM_SIMULATION_SEED=
AI_LLM_SIMULATION_ARTIFACT_DIR=/tmp/asa_llm_sim_runs
AI_LLM_SUBAGENT_RUNTIME_ENABLED=false
AI_LLM_SUBAGENT_RUNTIME_LAYERS=
AI_LLM_SUBAGENT_COMMAND=
AI_LLM_SUBAGENT_RUN_ID=
AI_LLM_SUBAGENT_ARTIFACT_DIR=/tmp/asa_llm_subagent_runs
AI_LLM_SUBAGENT_TIMEOUT_SEC=300

AI_COST_MANAGER_DAY_BUDGET_USDT=0
AI_COST_WARNING_THRESHOLD_RATIO=0.8
AI_COST_OVER_BUDGET_THRESHOLD_RATIO=1.0

CALLS_MIN_DURATION_SEC=180
CALLS_MAX_DAILY_PER_MANAGER=20
CALLS_WEEKLY_PACK_SIZE=15

NGINX_HTTP_PORT=8081
NGINX_HTTPS_PORT=8444
FLOWER_PORT=5556
FLOWER_USER=admin
FLOWER_PASSWORD=CHANGE_ME_FLOWER_PASSWORD
